# ─── Database ───
# PostgreSQL 17 connection string. Local dev: the db service in docker-compose.
DATABASE_URL=postgresql://spiceey:spiceey@localhost:5432/spiceey

# ─── Better Auth ───
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL where the Express server is reachable (used by Better Auth for callbacks)
BETTER_AUTH_URL=http://localhost:4000

# ─── Cloudinary (signed uploads) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=spiceey

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Server (Express) ───
# Express server's own URL
SERVER_URL=http://localhost:4000
# Next.js client URL — used for CORS origin
CLIENT_URL=http://localhost:3000

# ─── Client (Next.js) ───
# Express API URL exposed to the browser (NEXT_PUBLIC_ prefix = browser-visible)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
